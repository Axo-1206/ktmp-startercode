<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.edu.softwaretesting</groupId>
    <artifactId>assignment1-starter</artifactId>
    <version>1.0.0</version>
    <name>Assignment 1 - JUnit 5 Selenium Starter</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <selenium.version>4.27.0</selenium.version>
        <surefire.version>3.5.2</surefire.version>
        <!-- Thư mục lưu ảnh chụp màn hình khi test FAIL -->
        <screenshots.dir>${project.build.directory}/screenshots</screenshots.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <baseUrl>${baseUrl}</baseUrl>
                        <browser>${browser}</browser>
                        <headless>${headless}</headless>
                    </systemPropertyVariables>
                    <!-- Hiển thị System.out/err của từng test trong console Maven -->
                    <useFile>false</useFile>
                    <!-- Giữ nguyên XML + HTML report ngay cả khi test FAIL -->
                    <testFailureIgnore>false</testFailureIgnore>
                    <!-- Bật JUnit Platform provider (bắt buộc cho JUnit 5) -->
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>default-test-config</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <baseUrl>https://www.saucedemo.com</baseUrl>
                <browser>chrome</browser>
                <headless>true</headless>
            </properties>
        </profile>
    </profiles>
</project>
